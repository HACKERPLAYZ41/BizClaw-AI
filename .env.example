# Server Settings
PORT=3000

# Primary AI Model (OpenRouter)
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# 12 OpenRouter API Key Failover Slots
# If Key 1 hits rate limit (429) or error, system automatically switches to Key 2, Key 3... up to Key 12
OPENROUTER_API_KEY_1=sk-or-v1-key1...
OPENROUTER_API_KEY_2=sk-or-v1-key2...
OPENROUTER_API_KEY_3=sk-or-v1-key3...
OPENROUTER_API_KEY_4=sk-or-v1-key4...
OPENROUTER_API_KEY_5=sk-or-v1-key5...
OPENROUTER_API_KEY_6=sk-or-v1-key6...
OPENROUTER_API_KEY_7=sk-or-v1-key7...
OPENROUTER_API_KEY_8=sk-or-v1-key8...
OPENROUTER_API_KEY_9=sk-or-v1-key9...
OPENROUTER_API_KEY_10=sk-or-v1-key10...
OPENROUTER_API_KEY_11=sk-or-v1-key11...
OPENROUTER_API_KEY_12=sk-or-v1-key12...

# Alternatively, comma-separated list of keys:
# OPENROUTER_API_KEYS=key1,key2,key3,key4,key5,key6,key7,key8,key9,key10,key11,key12
